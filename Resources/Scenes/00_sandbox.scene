# The physics sandbox. Every shape here is generated in code, no model files.
# body = static never moves, dynamic is moved by physics.
name = Sandbox
environment = Resources/HDRIs/kloppenheim_02_1k.hdr

[camera]
position = 0 2.5 9
yaw = -90
pitch = -10
speed = 8

# Ground, 40 x 40 m
[model]
shape = plane
size = 40 1 40
color = 0.45
body = static

# A stack of 1 m crates, and one more dropped onto its corner
[model]
shape = box
position = -3 0.5 0
color = 0.8 0.55 0.3
body = dynamic

[model]
shape = box
position = -3 1.5 0
rotation = 0 20 0
color = 0.8 0.55 0.3
body = dynamic

[model]
shape = box
position = -3 2.5 0
rotation = 0 -15 0
color = 0.8 0.55 0.3
body = dynamic

[model]
shape = box
position = -2.6 6 0.3
rotation = 25 10 35
color = 0.8 0.55 0.3
body = dynamic

# A plank lying flat, and a low wall
[model]
shape = box
size = 4 0.2 0.6
position = 0 0.1 -2
color = 0.6 0.45 0.3
body = dynamic

[model]
shape = box
size = 0.5 1 6
position = 4 0.5 -1
color = 0.5 0.5 0.55
body = static

# Balls dropped from above, one onto the plank's end
[model]
shape = sphere
radius = 0.5
position = 1.6 4 -2
color = 0.75 0.15 0.15
body = dynamic

[model]
shape = sphere
radius = 0.25
position = 1 6 2
color = 0.15 0.35 0.75
body = dynamic

# Capsules at roughly character size. The standing one won't stay standing.
[model]
shape = capsule
radius = 0.3
height = 1.8
position = 2 0.9 1
rotation = 0 0 3
color = 0.3 0.65 0.35
body = dynamic

[model]
shape = capsule
radius = 0.2
height = 1.0
position = 2.8 0.2 2
rotation = 0 0 90
color = 0.85 0.8 0.3
body = dynamic
