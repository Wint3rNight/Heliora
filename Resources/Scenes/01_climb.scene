# The climb: a heap of junk to climb, about 53 m up to the gold platform,
# built for the character's "rage" variant (remy.character). Five zones,
# two or three ways through each, crossing back and forth over each other,
# so a fall lands on whatever is below, or all the way down. Every jump on
# the routes was run in the physics with the rage tuning. F5 twice starts
# over.

name = Climb
environment = Resources/HDRIs/kloppenheim_02_1k.hdr

[camera]
position = 44 22 52
yaw = -130
pitch = 4
speed = 12

[player]
position = 0 0 21
variant = rage

# Ground, 160 x 160 m
[model]
shape = plane
size = 160 1 160
color = 0.45
body = static

# Zone A, the yard pile, three ways up: crates on the west (easy), a
# steep plank and poles in the middle, balls on the east (hardest).
# They all reach the billboard.
[model]
shape = box
size = 7 0.7 4.5
position = 0 9.15 3
rotation = 0 6 0
color = 0.76 0.73 0.66
body = static

# Zone B, west (a narrow plank, poles, a pipe to balance along) or east
# (wider gaps, a steep plank), both to the rooftop.
[model]
shape = box
size = 6 0.7 4
position = 0 19.65 -16
rotation = 0 -10 0
color = 0.56 0.55 0.52
body = static

# Zone C, back south over the yard: a tower of tall steps on the west, or
# a pipe, a sprint gap and a steep ramp on the east.
[model]
shape = box
size = 4.5 0.7 3.5
position = 1 30.45 9
rotation = 0 -14 0
color = 0.41 0.43 0.26
body = static

# Zone D, north again: poles beside slabs too steep to stand on, or
# planks and a ball.
[model]
shape = box
size = 4 0.7 3
position = 2 41.05 -12
rotation = 0 9 0
color = 0.56 0.55 0.52
body = static

# Zone E, to the gold summit: small slabs far apart, or balls and a pipe.
