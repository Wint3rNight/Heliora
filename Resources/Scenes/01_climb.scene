# A climbing course: four laps of a square spiral, each harder than the
# last, up to the gold platform. Every piece is a static box, so it
# gets the 1 m grid. The character walks up 40 cm steps, gets onto
# ledges up to 1.5 m, and jumps about 5 m running and 8 m sprinting.
# Fall and you land on the lap below, or the ground. F5 twice starts
# over.

name = Climb
environment = Resources/HDRIs/kloppenheim_02_1k.hdr

[camera]
position = 28 18 34
yaw = -130
pitch = 0
speed = 10

# Ground, 160 x 160 m
[model]
shape = plane
size = 160 1 160
color = 0.45
body = static

# Lap 1, side 1: steps of 20 and 30 cm walk up; the two 45 cm
# ones need a jump (the character walks up 40 cm at most).
[model]
shape = box
size = 3 0.5 3
position = -6.5 -0.05 8
color = 0.42 0.52 0.68
body = static

[model]
