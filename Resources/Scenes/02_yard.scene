# The yard: things to break. Throw a ball with F, a heavy one with Shift+F,
# or knock things into each other. A concrete wall, a wooden fence, a hut
# whose roof rests on its walls, a tower of three blocks, a bridge on two
# stone pillars, and stacks of crates. Every breakable here is cut ahead of
# time into a few big pieces, its structure (break = pieces); the yellow lines
# when one is selected show them. The fine breaking happens where it's hit.

name = Yard
environment = Resources/HDRIs/kloppenheim_02_1k.hdr

[camera]
position = 0 3.5 24
pitch = -6
speed = 10

[player]
position = 0 0 18

# Ground, 160 x 160 m
[model]
shape = plane
size = 160 1 160
color = 0.45
body = static

# A concrete wall: a heavy ball punches a hole, the top falls in. Three times
# the strength it had in 1.3, when one heavy ball was meant to blow it open:
# a thrown stone piece went straight through.
[model]
shape = box
size = 6 3 0.3
position = 0 1.5 6
color = 0.62 0.6 0.56
body = static
material = stone
break = 12
break_seed = 1
break_strength = 360

# A wooden fence: lighter, it splinters into fewer, longer pieces
[model]
shape = box
size = 5 1.4 0.12
position = 7 0.7 10
rotation = 0 -20 0
color = 0.55 0.4 0.25
body = static
material = wood
break = 6
break_seed = 4
break_strength = 150

# The hut: four walls with a doorway and a roof resting on them. Take out the
# walls and the roof comes down.
