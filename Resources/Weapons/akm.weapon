# The AKM (step 1.6). Every number says where it's from. NSD is the Soviet
# AKM manual, Nastavlenie po strelkovomu delu, AKM i AKMS, Voenizdat 1970;
# the research notes with links are in next.md's sources.
[gun]
name = AKM
# Stein Games' CC0 AK47 through tools/weapon_convert (convert_guns.sh),
# scaled to the AKM's 880 mm
model = Resources/Models/Weapons/akm/akm.parts

[round]
# 7.62x39 steel-core ball (57-N-231)
bullet_mass = 0.0079   # kg, NSD p.159
muzzle_speed = 715     # m/s, NSD p.159
drag = G7
coefficient = 0.15     # fitted to NSD p.159's speeds and times out to 800 m
zero_range = 100       # m, NSD pp.89-92
tracer_every = 5       # FM 3-22.68's 4 ball to 1 tracer

[penetration]
# m into each material at a speed in m/s
wood_depth = 0.35      # stacked dry pine, 30-40 cm at 150 m (580 m/s), NSD p.158
wood_speed = 580
wood_depth2 = 0.25     # and 25 cm at 500 m (326 m/s), NSD p.158
wood_speed2 = 326
stone_depth = 0.135    # brick masonry, 12-15 cm at 100 m, NSD p.158
stone_speed = 623
dirt_depth = 0.275     # loose sandy loam, 25-30 cm at 500 m, NSD p.158
dirt_speed = 326
metal_depth = 0.008    # estimate: mild steel; 5.56 and 7.62 NATO go through a 3/8 in steel door (FM 3-06.11)
metal_speed = 623
ice_depth = 0.3        # estimate: NSD p.158 gives 70-80 cm of packed snow at 500 m; ice is denser
ice_speed = 326
rubber_depth = 0.3     # estimate
rubber_speed = 623
flesh_depth = 0.6      # estimate, until step 1.9
flesh_speed = 623

[action]
magazine = 30          # NSD p.3
rate = 600             # rounds a minute, cyclic, NSD p.3
automatic = true
locks_open = false     # no bolt hold-open: an empty reload needs the bolt pulled, NSD p.112

[spread]
# sigma in mrad, prone with a rest, short bursts: NSD p.161's probable
# errors (E) times 1.4826
first_up = 0.59        # E 4 cm at 100 m
first_side = 0.44      # E 3 cm
follow_up = 1.19       # E 8 cm
follow_side = 1.63     # E 11 cm
standing = 1.34        # NSD p.162, as extra rounds to hit, converted (research)
moving = 1.52
hip = 15               # estimate: no data; FM 3-06.11 says don't fire from the hip

[recoil]
impulse = 7.65         # N s, the SAAMI method: 0.0079 x 715 + 0.0016 x 1.75 x 715
return = 0.15          # estimate: s for the aim to come back to 1/e

[reload]
partial = 2.5          # estimate
empty = 3.2            # estimate, the bolt pulled too

[carry]
mass = 3.6             # kg loaded, NSD p.3
length = 0.88          # m, NSD p.3
spare_magazines = 4    # to check: one in the gun and four in the pouch

[sounds]
# The Free Firearm Sound Library's AK-47 (CC0, Resources/Sounds/CREDITS.md):
# a single shot near and from mid distance, cut to the first shot
shot = Resources/Sounds/guns/akm_shot_near.ogg
shot_far = Resources/Sounds/guns/akm_shot_mid.ogg
loudness = 160         # dB SPL at the shooter, rifles (Murphy et al. 2018)
