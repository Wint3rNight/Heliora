# The RPG-7 with the PG-7V rocket (step 1.7). "Wikipedia" is its RPG-7
# article, read 2026-11-20; the notes are in next.md (1.7 step 5).
[gun]
name = RPG-7
# TheParaziT's RPG-7 (Sketchfab, CC BY 4.0) through tools/weapon_convert
# (convert_guns.sh), scaled to the launcher's 950 mm
model = Resources/Models/Weapons/rpg7/rpg7.parts

[action]
magazine = 0           # loaded by hand at the muzzle, one rocket at a time
rate = 60              # the trigger, once a second at most (est.)
automatic = false

[spread]
# sigma in mrad off the line it's aimed along, from the shoulder: no
# figures at hand, all estimates (the wind and the drop are the big misses,
# and those are worked out)
first_up = 1.0         # estimate
first_side = 1.0       # estimate
follow_up = 1.0        # estimate
follow_side = 1.0      # estimate
standing = 1.5         # estimate
moving = 3.0           # estimate
hip = 30               # never used: it's only fired raised

[recoil]
impulse = 0            # recoilless: the back blast carries the push off behind
return = 0.15          # estimate
kick_back = 0.01       # estimate: m, the jolt you see
kick_up = 2.0          # estimate: degrees
kick_aside = 0.5       # estimate: degrees
kick_peak = 0.05       # estimate: s

[reload]
partial = 6.0          # estimate: s for a rocket off the back into the muzzle
empty = 6.0            # the same: there's nothing to cycle

[carry]
mass = 8.5             # kg: the launcher 6.3 without its sight (Wikipedia), a rocket 2.2 (est.)
length = 0.95          # m, Wikipedia
spare_magazines = 2    # rockets in the pack besides the one loaded (est.)

[sounds]
# Stand-ins until a recording: the AKM's shot near and far
shot = Resources/Sounds/guns/akm_shot_near.ogg
shot_far = Resources/Sounds/guns/akm_shot_mid.ogg
loudness = 180         # estimate: dB SPL at the gunner

[rocket]
# The PG-7V
mass = 2.2             # estimate: kg, not in the article
diameter = 0.085       # m, the warhead, Wikipedia
launch_speed = 115     # m/s off the launcher (the booster), Wikipedia
motor_from = 10        # m flown when the motor lights, Wikipedia
motor_to = 500         # m flown when it burns out, Wikipedia ("sustains flight out to 500 m")
top_speed = 295        # m/s then, Wikipedia
self_destruct = 4.5    # s, Wikipedia (the fuze)
reach = 920            # m flown by then, Wikipedia (the usual maximum range)
# The thrust and drag aren't documented: fitted at load so it meets those.

[warhead]
steel = 0.26           # m of steel armour the jet goes through, Wikipedia
tnt = 0.7              # estimate: kg; the PG-7VL's 93 mm warhead holds 730 g of OKFOL
                       # (Wikipedia's table), scaled to 85 mm by volume and by about 1.3 for TNT
